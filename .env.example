# AI Study & Safety Coach Environment Configuration

# Server
PORT=4000
NODE_ENV=development
JWT_SECRET=super-secret-jwt-key-study-coach-change-me
JWT_EXPIRES_IN=7d

# Database (PostgreSQL)
# Leave empty to automatically use embedded zero-dependency PGlite!
DATABASE_URL=
PGLITE_DATA_DIR=./.pglite-data
SEED_DEMO_DATA=true

# AI Provider Configuration ('mock' | 'gemini' | 'openai')
AI_PROVIDER=mock

# Gemini API Configuration (when AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Configuration (when AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Thresholds and Monitoring
IDLE_THRESHOLD_SECONDS=300
DISTRACTION_CONFIDENCE_THRESHOLD=0.70
SAFETY_CONFIDENCE_THRESHOLD=0.80
CONTEXT_CAPTURE_COOLDOWN_MS=5000
ALERT_DEDUP_COOLDOWN_MS=60000
HEARTBEAT_INTERVAL_MS=30000
HEARTBEAT_TIMEOUT_MS=90000

# n8n Automation & Anti-Tamper Security Webhook
N8N_SECURITY_WEBHOOK_URL=http://localhost:5678/webhook/aipd-security-alert
PARENT_PIN_AUTO_LOCK_MINUTES=5
